# Copy to .env.production on the VPS. Never commit the real file.
# Use the MongoDB Atlas connection string; do not use a local MongoDB container.
MONGODB_URL=
MONGODB_DB_NAME=action_pilot

# Public API hostname, e.g. api.your-domain.example
API_DOMAIN=

# Exact browser origins, comma-separated; no trailing slash.
CORS_ORIGINS=https://darkblue-turkey-867661.hostingersite.com

# Meta model API secret. Keep only on the backend.
MODEL_API_KEY=
# Optional; leave unset to use the application default.
# META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Paper trading remains disabled until explicitly configured and authorized.
PAPER_TRADING_ENABLED=false
PAPER_API_TOKEN=
# Set only after deciding the virtual paper balance; never use real funds here.
# PAPER_INITIAL_BALANCE_USD=
