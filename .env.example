# Local development environment. Copy to .env and fill in real values.
# Never commit .env with secrets.
MONGODB_URL=
MONGODB_DB_NAME=action_pilot

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Inference Providers (server-side only; never expose HF_TOKEN to the frontend).
HF_TOKEN=
HF_CHAT_MODEL=Qwen/Qwen3-4B-Thinking-2507:cheapest
HF_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions
HF_REQUEST_TIMEOUT_SECONDS=20
HF_STRATEGY_ADVISORY_ENABLED=false # enable only when you want Qwen notes during every analysis cycle
# Deterministic signals and risk controls remain authoritative.

# Exness Trader API — READ ONLY. Create a key with Trading read access only.
# Obtain the Gateway URL from the DNS widget in Exness Key Management.
# Never commit real values or expose them to the frontend.
EXN_API_KEY=
EXN_PRIVATE_KEY=
EXN_ACCOUNT_ID=
EXN_DISCOVERY_BASE_URL=
EXN_READ_ONLY=true

PAPER_TRADING_ENABLED=false
PAPER_API_TOKEN=
# Set to exness to use Exness read-only bid/ask ticks and candles for paper trading.
# Supported initial instruments: XAU/USD, EUR/USD and GBP/USD.
PAPER_MARKET_DATA_PROVIDER=yahoo

# Autonomous paper trading (demo only)
PAPER_INITIAL_BALANCE_USD=100.00
PAPER_AUTOTRADING_ALLOWED=true
PAPER_AUTOTRADING_USE_LLM=false # legacy compatibility only; HF advisory is separate
PAPER_AUTOTRADING_SCAN_SECONDS=30
PAPER_AUTOTRADING_MONITOR_SECONDS=10
PAPER_AUTOTRADING_MIN_CONFIDENCE=0.62
PAPER_AUTOTRADING_CANDLE_INTERVAL=5
RISK_MAX_TRADE_RISK_PCT=2.0
RISK_MAX_DAILY_LOSS_PCT=6.0
RISK_MAX_DRAWDOWN_PCT=12.0
RISK_MAX_OPEN_POSITIONS=6
RISK_MAX_LEVERAGE=1.0
RISK_REQUIRE_STOP_LOSS=true
