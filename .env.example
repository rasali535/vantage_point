# Local development environment. Copy to .env and fill in real values.
# Never commit .env with secrets.
MONGODB_URL=
MONGODB_DB_NAME=action_pilot

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hugging Face Inference Providers (server-side only; never expose HF_TOKEN to the frontend).\nHF_TOKEN=\nHF_CHAT_MODEL=Qwen/Qwen2.5-3B-Instruct\nHF_CHAT_COMPLETIONS_URL=https://router.huggingface.co/v1/chat/completions\nHF_REQUEST_TIMEOUT_SECONDS=20\nHF_STRATEGY_ADVISORY_ENABLED=true\n# Deterministic signals and risk controls remain authoritative.

PAPER_TRADING_ENABLED=false
PAPER_API_TOKEN=

# Autonomous paper trading (demo only)
PAPER_INITIAL_BALANCE_USD=100.00
PAPER_AUTOTRADING_ALLOWED=true
PAPER_AUTOTRADING_USE_LLM=false # legacy compatibility only; HF advisory is separate
PAPER_AUTOTRADING_SCAN_SECONDS=30
PAPER_AUTOTRADING_MONITOR_SECONDS=10
PAPER_AUTOTRADING_MIN_CONFIDENCE=0.62
PAPER_AUTOTRADING_CANDLE_INTERVAL=5
RISK_MAX_TRADE_RISK_PCT=2.0
RISK_MAX_DAILY_LOSS_PCT=6.0
RISK_MAX_DRAWDOWN_PCT=12.0
RISK_MAX_OPEN_POSITIONS=6
RISK_MAX_LEVERAGE=1.0
RISK_REQUIRE_STOP_LOSS=true
