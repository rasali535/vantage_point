# Local development environment. Copy to .env and fill in real values.
# Never commit .env with secrets.
MONGODB_URL=
MONGODB_DB_NAME=action_pilot

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Meta Model API key from the Meta developer dashboard (dev.meta.ai).
# Required for chat, market research, risk and strategy agents.
MODEL_API_KEY=
# Optional; leave unset to use https://api.meta.ai/v1
# META_MODEL_API_BASE_URL=https://api.meta.ai/v1

PAPER_TRADING_ENABLED=false
PAPER_API_TOKEN=
